{% import 'extension/pn_black/admin/view/template/module/pn_black/_macros.twig' as dc %}
{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_start.twig' %}

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-language"></i></span>
    <div><h3 class="dc-section-card__title">{{ entry_title }}</h3></div>
  </div>
  {{ dc.multilang_fields('', [
    { key: 'badge', label: entry_badge },
    { key: 'title', label: entry_title },
    { key: 'title_accent', label: entry_title_accent }
  ], settings, languages, 'brands-head') }}
</div>

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-industry"></i></span>
    <div>
      <h3 class="dc-section-card__title">{{ entry_selected }}</h3>
      <p class="dc-section-card__sub">{{ help_brands }}</p>
    </div>
  </div>

  {% set selected = settings.selected|default([]) %}
  <div class="dc-tile-grid dc-tile-grid--brands" data-dc-selectable-tiles>
    {% for manufacturer in manufacturers %}
      {% set mid = manufacturer.manufacturer_id %}
      {% set is_selected = mid in selected %}
      {% set m_thumb = placeholder %}
      {% if manufacturer.image|default('') %}
        {% set m_thumb = '../image/' ~ manufacturer.image %}
      {% endif %}
      <div class="dc-select-tile dc-select-tile--brand{% if is_selected %} dc-select-tile--active{% endif %}" data-dc-select-tile>
        <label class="dc-check dc-select-tile__check">
          <input class="dc-check__input" type="checkbox" name="module_pn_black[selected][]" value="{{ mid }}"{% if is_selected %} checked{% endif %} data-dc-tile-checkbox/>
          <span class="dc-check__box"></span>
        </label>
        <div class="dc-select-tile__image">
          <img src="{{ m_thumb }}" alt="{{ manufacturer.name }}" loading="lazy"/>
        </div>
        <div class="dc-select-tile__body">
          <strong class="dc-select-tile__name">{{ manufacturer.name }}</strong>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_end.twig' %}
