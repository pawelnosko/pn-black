{% import 'extension/pn_black/admin/view/template/module/pn_black/_macros.twig' as dc %}
{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_start.twig' %}

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-language"></i></span>
    <div><h3 class="dc-section-card__title">{{ entry_title }}</h3></div>
  </div>
  {{ dc.multilang_fields('', [
    { key: 'badge', label: entry_badge },
    { key: 'title', label: entry_title },
    { key: 'title_accent', label: entry_title_accent }
  ], settings, languages, 'featured-head') }}
</div>

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-shopping-cart"></i></span>
    <div>
      <h3 class="dc-section-card__title">{{ entry_product }}</h3>
      <p class="dc-section-card__sub">{{ text_select_products }}</p>
    </div>
  </div>
  <div class="dc-row dc-row--2">
    <div class="dc-field">
      <label class="dc-label">{{ entry_product }} 1</label>
      <select class="dc-input" name="module_pn_black[product_1]">
        <option value="0">—</option>
        {% for product in products %}
          <option value="{{ product.product_id }}"{% if settings.product_1|default(0) == product.product_id %} selected{% endif %}>{{ product.name }}</option>
        {% endfor %}
      </select>
    </div>
    <div class="dc-field">
      <label class="dc-label">{{ entry_product }} 2</label>
      <select class="dc-input" name="module_pn_black[product_2]">
        <option value="0">—</option>
        {% for product in products %}
          <option value="{{ product.product_id }}"{% if settings.product_2|default(0) == product.product_id %} selected{% endif %}>{{ product.name }}</option>
        {% endfor %}
      </select>
    </div>
  </div>
  <div class="dc-lang-pills">
    {% for language in languages %}
      {{ dc.language_pill(language, 'lang-featured-badges-' ~ language.language_id, loop.first) }}
    {% endfor %}
  </div>
  {% for language in languages %}
    <div class="dc-lang-panel{% if loop.first %} dc-active{% endif %}" id="lang-featured-badges-{{ language.language_id }}">
      <div class="dc-row dc-row--2">
        <div class="dc-field">
          <label class="dc-label">{{ entry_product_badge }} 1</label>
          <input class="dc-input" type="text" name="module_pn_black[product_1_badge][{{ language.language_id }}]" value="{{ settings.product_1_badge[language.language_id]|default('') }}"/>
        </div>
        <div class="dc-field">
          <label class="dc-label">{{ entry_product_badge }} 2</label>
          <input class="dc-input" type="text" name="module_pn_black[product_2_badge][{{ language.language_id }}]" value="{{ settings.product_2_badge[language.language_id]|default('') }}"/>
        </div>
      </div>
    </div>
  {% endfor %}
</div>

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-gift"></i></span>
    <div><h3 class="dc-section-card__title">{{ entry_club_title }}</h3></div>
  </div>
  {{ dc.multilang_fields('', [
    { key: 'club_title', label: entry_club_title },
    { key: 'club_description', label: entry_club_description, type: 'textarea', rows: 3 },
    { key: 'club_cta', label: entry_club_cta }
  ], settings, languages, 'featured-club') }}
  <div class="dc-field">
    <label class="dc-label">{{ entry_club_link }}</label>
    <input class="dc-input" type="text" name="module_pn_black[club_link]" value="{{ settings.club_link|default('') }}"/>
  </div>
</div>

{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_end.twig' %}
