{% import 'extension/pn_black/admin/view/template/module/pn_black/_macros.twig' as dc %}
{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_start.twig' %}

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-language"></i></span>
    <div><h3 class="dc-section-card__title">{{ entry_title }}</h3></div>
  </div>
  {{ dc.multilang_fields('', [
    { key: 'badge', label: entry_badge },
    { key: 'title', label: entry_title },
    { key: 'title_accent', label: entry_title_accent },
    { key: 'based_on', label: entry_based_on }
  ], settings, languages, 'reviews-head') }}
  <div class="dc-field">
    <label class="dc-label">{{ entry_rating }}</label>
    <input class="dc-input" type="text" name="module_pn_black[rating]" value="{{ settings.rating|default('4.9') }}"/>
  </div>
</div>

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-comments"></i></span>
    <div><h3 class="dc-section-card__title">{{ section_reviews }}</h3></div>
    <div class="dc-section-card__actions">
      <button type="button" class="dc-btn dc-btn--light" data-dc-add-item="items" data-dc-template="review-template"><i class="fa fa-plus"></i> {{ text_add_review }}</button>
    </div>
  </div>

  <div class="dc-accordion dc-accordion--sortable" id="reviews-accordion" data-dc-accordion-list="items" data-dc-reindex="module_pn_black[items]">
    {% set reviews = settings.items|default([]) %}
    {% for review in reviews %}
      {% set idx = loop.index0 %}
      {% set review_title = review.author|default('Review ' ~ (idx + 1)) %}
      <div class="dc-accordion__item{% if loop.first %} dc-open{% endif %}" data-dc-accordion-item data-dc-index="{{ idx }}">
        <div class="dc-accordion__header-row">
          <span class="dc-sort-handle dc-accordion__handle" title="{{ text_drag }}"><i class="fa fa-bars"></i></span>
          <button type="button" class="dc-accordion__trigger" data-dc-accordion-trigger aria-expanded="{{ loop.first ? 'true' : 'false' }}">
            <span class="dc-accordion__icon">{{ review.avatar|default('💬') }}</span>
            <span class="dc-accordion__title">
              {{ review_title }}
              <span class="dc-accordion__sub">{{ review.product|default('') }}</span>
            </span>
            <svg class="dc-accordion__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <button type="button" class="dc-btn dc-btn--ghost dc-btn--danger" data-dc-remove-item title="Remove"><i class="fa fa-trash"></i></button>
        </div>
        <div class="dc-accordion__panel">
          <div class="dc-accordion__content">
            <div class="dc-accordion__body">
              <div class="dc-row dc-row--2">
                {{ dc.emoji_picker('[items][' ~ idx ~ '][avatar]', review.avatar|default('👩'), 'people', 'review-avatar-' ~ idx) }}
                <div class="dc-field">
                  <label class="dc-label">{{ entry_date }}</label>
                  <input class="dc-input" type="date" name="module_pn_black[items][{{ idx }}][date]" value="{{ review.date|default('') }}"/>
                </div>
              </div>
              <div class="dc-field">
                <label class="dc-label">{{ entry_stars }}</label>
                <div class="dc-star-rating" data-star-rating data-star-input="#input-review-stars-{{ idx }}">
                  {% set stars = review.stars|default(5) %}
                  {% for s in 1..5 %}
                    <button type="button" class="dc-star-rating__star{% if s <= stars %} dc-star-rating__star--active{% endif %}" data-star-value="{{ s }}" aria-label="{{ s }} stars"><i class="fa fa-star"></i></button>
                  {% endfor %}
                </div>
                <input type="hidden" name="module_pn_black[items][{{ idx }}][stars]" value="{{ stars }}" id="input-review-stars-{{ idx }}"/>
              </div>
              <div class="dc-row dc-row--2">
                <div class="dc-field">
                  <label class="dc-label">{{ entry_author }}</label>
                  <input class="dc-input" type="text" name="module_pn_black[items][{{ idx }}][author]" value="{{ review.author|default('') }}" data-dc-review-author/>
                </div>
                <div class="dc-field">
                  <label class="dc-label">{{ entry_product_name }}</label>
                  <input class="dc-input" type="text" name="module_pn_black[items][{{ idx }}][product]" value="{{ review.product|default('') }}"/>
                </div>
              </div>
              <div class="dc-lang-pills">
                {% for language in languages %}
                  {{ dc.language_pill(language, 'lang-review-' ~ idx ~ '-' ~ language.language_id, loop.first) }}
                {% endfor %}
              </div>
              {% for language in languages %}
                <div class="dc-lang-panel{% if loop.first %} dc-active{% endif %}" id="lang-review-{{ idx }}-{{ language.language_id }}">
                  <div class="dc-field">
                    <label class="dc-label">{{ entry_review_text }}</label>
                    <textarea class="dc-input" rows="4" name="module_pn_black[items][{{ idx }}][text][{{ language.language_id }}]">{{ review.text[language.language_id]|default('') }}</textarea>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<template id="review-template">
  <div class="dc-accordion__item dc-open" data-dc-accordion-item data-dc-index="__INDEX__">
    <div class="dc-accordion__header-row">
      <span class="dc-sort-handle dc-accordion__handle" title="{{ text_drag }}"><i class="fa fa-bars"></i></span>
      <button type="button" class="dc-accordion__trigger" data-dc-accordion-trigger aria-expanded="true">
        <span class="dc-accordion__icon">💬</span>
        <span class="dc-accordion__title">
          New review
          <span class="dc-accordion__sub">{{ entry_author }}</span>
        </span>
        <svg class="dc-accordion__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <button type="button" class="dc-btn dc-btn--ghost dc-btn--danger" data-dc-remove-item title="Remove"><i class="fa fa-trash"></i></button>
    </div>
    <div class="dc-accordion__panel">
      <div class="dc-accordion__content">
        <div class="dc-accordion__body">
          <div class="dc-row dc-row--2">
            <div class="dc-field dc-emoji-field">
              <label class="dc-label">{{ entry_avatar }}</label>
              <div class="dc-emoji-picker-wrap">
                <button type="button" class="dc-btn dc-btn--ghost dc-emoji-trigger" data-emoji-target="#input-review-avatar-__INDEX__" data-emoji-preview="#preview-review-avatar-__INDEX__" data-emoji-source="people">
                  <span class="dc-emoji-preview" id="preview-review-avatar-__INDEX__">👩</span>
                </button>
                <input type="hidden" name="module_pn_black[items][__INDEX__][avatar]" value="👩" id="input-review-avatar-__INDEX__"/>
              </div>
            </div>
            <div class="dc-field">
              <label class="dc-label">{{ entry_date }}</label>
              <input class="dc-input" type="date" name="module_pn_black[items][__INDEX__][date]" value=""/>
            </div>
          </div>
          <div class="dc-field">
            <label class="dc-label">{{ entry_stars }}</label>
            <div class="dc-star-rating" data-star-rating data-star-input="#input-review-stars-__INDEX__">
              {% for s in 1..5 %}
                <button type="button" class="dc-star-rating__star{% if s <= 5 %} dc-star-rating__star--active{% endif %}" data-star-value="{{ s }}"><i class="fa fa-star"></i></button>
              {% endfor %}
            </div>
            <input type="hidden" name="module_pn_black[items][__INDEX__][stars]" value="5" id="input-review-stars-__INDEX__"/>
          </div>
          <div class="dc-row dc-row--2">
            <div class="dc-field">
              <label class="dc-label">{{ entry_author }}</label>
              <input class="dc-input" type="text" name="module_pn_black[items][__INDEX__][author]" value="" data-dc-review-author/>
            </div>
            <div class="dc-field">
              <label class="dc-label">{{ entry_product_name }}</label>
              <input class="dc-input" type="text" name="module_pn_black[items][__INDEX__][product]" value=""/>
            </div>
          </div>
          <div class="dc-lang-pills">
            {% for language in languages %}
              {{ dc.language_pill(language, 'lang-review-__INDEX__-' ~ language.language_id, loop.first) }}
            {% endfor %}
          </div>
          {% for language in languages %}
            <div class="dc-lang-panel{% if loop.first %} dc-active{% endif %}" id="lang-review-__INDEX__-{{ language.language_id }}">
              <div class="dc-field">
                <label class="dc-label">{{ entry_review_text }}</label>
                <textarea class="dc-input" rows="4" name="module_pn_black[items][__INDEX__][text][{{ language.language_id }}]"></textarea>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</template>

{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_end.twig' %}
