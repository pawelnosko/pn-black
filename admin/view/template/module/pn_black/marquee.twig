{% import 'extension/pn_black/admin/view/template/module/pn_black/_macros.twig' as dc %}
{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_start.twig' %}

<div class="dc-section-card dc-section">
  <div class="dc-section-card__head">
    <span class="dc-section-card__icon"><i class="fa fa-ellipsis-h"></i></span>
    <div>
      <h3 class="dc-section-card__title">{{ section_marquee }}</h3>
      <p class="dc-section-card__sub">Scrolling phrases under the hero</p>
    </div>
    <div class="dc-section-card__actions">
      <button type="button" class="dc-btn dc-btn--light" data-dc-add-item="items" data-dc-template="marquee-template"><i class="fa fa-plus"></i> Add phrase</button>
    </div>
  </div>

  <div class="dc-accordion dc-accordion--sortable" id="marquee-accordion" data-dc-accordion-list="items" data-dc-reindex="module_pn_black[items]">
    {% set items = settings.items|default([]) %}
    {% for item in items %}
      {% set idx = loop.index0 %}
      {% set item_title = item.text[languages[0].language_id]|default('Phrase ' ~ (idx + 1)) %}
      <div class="dc-accordion__item{% if loop.first %} dc-open{% endif %}" data-dc-accordion-item data-dc-index="{{ idx }}">
        <div class="dc-accordion__header-row">
          <span class="dc-sort-handle dc-accordion__handle" title="{{ text_drag }}"><i class="fa fa-bars"></i></span>
          <button type="button" class="dc-accordion__trigger" data-dc-accordion-trigger aria-expanded="{{ loop.first ? 'true' : 'false' }}">
            <span class="dc-accordion__icon">〰</span>
            <span class="dc-accordion__title">{{ item_title }}</span>
            <svg class="dc-accordion__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
          </button>
          <button type="button" class="dc-btn dc-btn--ghost dc-btn--danger" data-dc-remove-item title="Remove"><i class="fa fa-trash"></i></button>
        </div>
        <div class="dc-accordion__panel">
          <div class="dc-accordion__content">
            <div class="dc-accordion__body">
              <div class="dc-lang-pills">
                {% for language in languages %}
                  {{ dc.language_pill(language, 'lang-marquee-' ~ idx ~ '-' ~ language.language_id, loop.first) }}
                {% endfor %}
              </div>
              {% for language in languages %}
                <div class="dc-lang-panel{% if loop.first %} dc-active{% endif %}" id="lang-marquee-{{ idx }}-{{ language.language_id }}">
                  <div class="dc-field">
                    <label class="dc-label">Phrase</label>
                    <input class="dc-input" type="text" name="module_pn_black[items][{{ idx }}][text][{{ language.language_id }}]" value="{{ item.text[language.language_id]|default('') }}" data-dc-slide-title/>
                  </div>
                </div>
              {% endfor %}
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

<template id="marquee-template">
  <div class="dc-accordion__item dc-open" data-dc-accordion-item data-dc-index="__INDEX__">
    <div class="dc-accordion__header-row">
      <span class="dc-sort-handle dc-accordion__handle" title="{{ text_drag }}"><i class="fa fa-bars"></i></span>
      <button type="button" class="dc-accordion__trigger" data-dc-accordion-trigger aria-expanded="true">
        <span class="dc-accordion__icon">〰</span>
        <span class="dc-accordion__title">New phrase</span>
        <svg class="dc-accordion__chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
      </button>
      <button type="button" class="dc-btn dc-btn--ghost dc-btn--danger" data-dc-remove-item title="Remove"><i class="fa fa-trash"></i></button>
    </div>
    <div class="dc-accordion__panel">
      <div class="dc-accordion__content">
        <div class="dc-accordion__body">
          <div class="dc-lang-pills">
            {% for language in languages %}
              {{ dc.language_pill(language, 'lang-marquee-__INDEX__-' ~ language.language_id, loop.first) }}
            {% endfor %}
          </div>
          {% for language in languages %}
            <div class="dc-lang-panel{% if loop.first %} dc-active{% endif %}" id="lang-marquee-__INDEX__-{{ language.language_id }}">
              <div class="dc-field">
                <label class="dc-label">Phrase</label>
                <input class="dc-input" type="text" name="module_pn_black[items][__INDEX__][text][{{ language.language_id }}]" value="" data-dc-slide-title/>
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</template>

{% include 'extension/pn_black/admin/view/template/module/pn_black/_layout_end.twig' %}
