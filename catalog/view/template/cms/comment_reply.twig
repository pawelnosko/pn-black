{% if replies %}
  <div id="reply-{{ parent_id }}-{{ page }}" class="pn-reply-list">
    {% for reply in replies %}
      <article class="pn-reply">
        <header class="pn-comment__meta">
          <span>{{ text_by }} {{ reply.author }}</span>
          <time>{{ reply.date_added }}</time>
        </header>
        <p class="pn-comment__text">{{ reply.comment }}</p>
      </article>
    {% endfor %}
  </div>
{% endif %}
<div class="pn-comment-replies__bar">
  <button type="button" value="{{ refresh }}" id="button-refresh-{{ parent_id }}" data-oc-toggle="refresh" data-oc-target="#reply-{{ parent_id }}-{{ page }}" class="pn-btn pn-btn--outline d-none"><i class="fa fa-sync"></i></button>
  {% if not replies %}
    <button type="button" class="pn-btn pn-btn--outline" disabled>{{ button_replies }}</button>
  {% elseif next %}
    <button type="button" value="{{ next }}" data-oc-toggle="next" class="pn-btn pn-btn--outline">{{ button_more }}</button>
  {% else %}
    <button type="button" class="pn-btn pn-btn--outline" disabled>{{ button_more }}</button>
  {% endif %}
</div>
