<div id="comment-0" class="pn-comment-list">
  {% if comments %}
    {% for comment in comments %}
      <article id="comment-{{ comment.article_comment_id }}" class="pn-comment">
        <header class="pn-comment__meta">
          <span>{{ text_by }} {{ comment.author }}</span>
          <time>{{ comment.date_added }}</time>
        </header>
        <p class="pn-comment__text">{{ comment.comment }}</p>
        <div class="pn-comment__actions">
          {% if logged %}
            <button type="button" value="{{ comment.like }}" data-bs-toggle="tooltip" title="{{ button_like }}" data-oc-toggle="rate" class="pn-btn pn-btn--outline"><i class="fa fa-thumbs-up"></i></button>
            <button type="button" value="{{ comment.dislike }}" data-bs-toggle="tooltip" title="{{ button_dislike }}" data-oc-toggle="rate" class="pn-btn pn-btn--outline"><i class="fa fa-thumbs-down"></i></button>
            <button type="button" value="{{ comment.reply_add }}" data-oc-toggle="comment" data-oc-target="#reply-{{ comment.article_comment_id }}" data-oc-trigger="#button-refresh-{{ comment.article_comment_id }}" class="pn-btn pn-btn--outline">{{ button_reply }}</button>
          {% else %}
            <a href="{{ login }}" class="pn-btn pn-btn--outline"><i class="fa fa-thumbs-up"></i></a>
            <a href="{{ login }}" class="pn-btn pn-btn--outline"><i class="fa fa-thumbs-down"></i></a>
            <a href="{{ login }}" class="pn-btn pn-btn--outline">{{ button_login_reply }}</a>
          {% endif %}
        </div>
        <div id="reply-{{ comment.article_comment_id }}" class="pn-comment-replies">
          <div id="reply-{{ comment.article_comment_id }}-0"></div>
          <div class="pn-comment-replies__bar">
            <button type="button" value="{{ comment.reply }}" id="button-refresh-{{ comment.article_comment_id }}" data-oc-toggle="refresh" data-oc-target="#reply-{{ comment.article_comment_id }}-0" class="pn-btn pn-btn--outline d-none"><i class="fa fa-sync"></i></button>
            {% if comment.reply_total %}
              <button type="button" value="{{ comment.reply }}" data-oc-toggle="next" class="pn-btn pn-btn--outline">{{ button_replies }} ({{ comment.reply_total }})</button>
            {% else %}
              <button type="button" class="pn-btn pn-btn--outline" disabled>{{ button_replies }}</button>
            {% endif %}
          </div>
        </div>
      </article>
    {% endfor %}
    <div class="pn-blog-foot">
      <div class="pn-pagination-wrap">{{ pagination }}</div>
      {% if results %}<p class="pn-blog-results">{{ results }}</p>{% endif %}
    </div>
  {% else %}
    <p class="pn-blog-empty">{{ text_no_results }}</p>
  {% endif %}
</div>
<div class="pn-comment-refresh">
  <button type="button" value="{{ refresh }}" id="button-refresh" data-oc-toggle="refresh" data-oc-target="#comment-0" class="pn-btn pn-btn--outline d-none"><i class="fa fa-sync"></i></button>
</div>
