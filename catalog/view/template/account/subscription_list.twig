{{ header }}
<div id="account-subscription" class="pn-account-page">
  {% include 'extension/pn_black/catalog/view/template/common/breadcrumb.twig' %}

  <div class="pn-account-layout">
    {{ column_left }}

    <div id="content" class="pn-account-content">
      {{ content_top }}

      <header class="pn-account-head">
              <p class="pn-eyebrow gold-text">Account</p>
              <h1 class="pn-account-title">{{ heading_title }}</h1>
            </header>
            {% if subscriptions %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <th class="text-end">{{ column_subscription_id }}</th>
                      <th class="text-end">{{ column_product_total }}</th>
                      <th>{{ column_description }}</th>
                      <th>{{ column_status }}</th>
                      <th>{{ column_date_added }}</th>
                      <th class="text-end"></th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for subscription in subscriptions %}
                      <tr>
                        <td class="text-end">#{{ subscription.subscription_id }}</td>
                        <td class="text-end">{{ subscription.product_total }}</td>
                        <td>{{ subscription.description }}</td>
                        <td>{{ subscription.status }}</td>
                        <td>{{ subscription.date_added }}</td>
                        <td class="text-end"><a href="{{ subscription.view }}" data-bs-toggle="tooltip" title="{{ button_view }}" class="pn-btn pn-btn--outline pn-btn--icon"><i class="fa-solid fa-eye"></i></a></td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="pn-account-foot">
              <div class="pn-pagination-wrap">{{ pagination }}</div>
              <p class="pn-account-results">{{ results }}</p>
            </div>
            {% else %}
              <p>{{ text_no_subscription }}</p>
            {% endif %}
            <div class="pn-account-actions pn-account-actions--end">
              <a href="{{ continue }}" class="pn-btn pn-btn--black">{{ button_continue }}</a>
            </div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
