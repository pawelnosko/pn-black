  Author: Paweł Nosko → https://pawelnosko.com/
  Company: Design Cart → https://www.designcart.pl/
#}
{{ header }}
<div id="account-newsletter" class="pn-account-page">
  {% include 'extension/pn_black/catalog/view/template/common/breadcrumb.twig' %}

  <div class="pn-account-layout">
    {{ column_left }}

    <div id="content" class="pn-account-content">
      {{ content_top }}

      <header class="pn-account-head">
              <p class="pn-eyebrow gold-text">Account</p>
              <h1 class="pn-account-title">{{ heading_title }}</h1>
            </header>
            <form id="form-newsletter" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <fieldset>
                <div class="row mb-3 mb-0">
                  <label class="col-md-3 col-form-label">{{ entry_newsletter }}</label>
                  <div class="col-md-9">
                    <div class="form-check form-switch form-switch-lg">
                      <input type="hidden" name="newsletter" value="0"/>
                      <input type="checkbox" name="newsletter" value="1" id="input-newsletter" class="form-check-input"{% if newsletter %} checked{% endif %}/>
                    </div>
                  </div>
                </div>
              </fieldset>
              <div class="pn-account-actions">
              <a href="{{ back }}" class="pn-btn pn-btn--outline">{{ button_back }}</a>
              <button type="submit" class="pn-btn pn-btn--black">{{ button_continue }}</button>
            </div>
            </form>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
