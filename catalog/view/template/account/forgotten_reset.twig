{{ header }}
<div id="account-reset" class="pn-account-page">
  {% include 'extension/pn_black/catalog/view/template/common/breadcrumb.twig' %}

  <div class="pn-account-layout">
    {{ column_left }}

    <div id="content" class="pn-account-content">
      {{ content_top }}

      <header class="pn-account-head">
              <p class="pn-eyebrow gold-text">Account</p>
              <h1 class="pn-account-title">{{ heading_title }}</h1>
            </header>
            <form id="form-reset" action="{{ save }}" method="post" data-oc-toggle="ajax">
              <fieldset>
                <legend>{{ text_password }}</legend>
                <div class="row mb-3">
                  <label for="input-password" class="col-sm-2 col-form-label">{{ entry_password }}</label>
                  <div class="col-sm-10">
                    <input type="password" name="password" value="" id="input-password" class="form-control"/>
                    <div id="error-password" class="invalid-feedback"></div>
                  </div>
                </div>
                <div class="row mb-3">
                  <label for="input-confirm" class="col-sm-2 col-form-label">{{ entry_confirm }}</label>
                  <div class="col-sm-10">
                    <input type="password" name="confirm" value="" id="input-confirm" class="form-control"/>
                    <div id="error-confirm" class="invalid-feedback"></div>
                  </div>
                </div>
              </fieldset>
              <div class="pn-account-actions">
              <a href="{{ back }}" class="pn-btn pn-btn--outline">{{ button_back }}</a>
              <button type="submit" class="pn-btn pn-btn--black">{{ button_continue }}</button>
            </div>
            </form>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
