{{ header }}
<div id="account-download" class="pn-account-page">
  {% include 'extension/pn_black/catalog/view/template/common/breadcrumb.twig' %}

  <div class="pn-account-layout">
    {{ column_left }}

    <div id="content" class="pn-account-content">
      {{ content_top }}

      <header class="pn-account-head">
              <p class="pn-eyebrow gold-text">Account</p>
              <h1 class="pn-account-title">{{ heading_title }}</h1>
            </header>
            {% if downloads %}
              <div class="table-responsive">
                <table class="table table-bordered table-hover">
                  <thead>
                    <tr>
                      <th class="text-end"><strong>{{ column_order_id }}</strong></th>
                      <th><strong>{{ column_name }}</strong></th>
                      <th><strong>{{ column_size }}</strong></th>
                      <th><strong>{{ column_date_added }}</strong></th>
                      <th></th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for download in downloads %}
                      <tr>
                        <td class="text-end">{{ download.order_id }}</td>
                        <td>{{ download.name }}</td>
                        <td>{{ download.size }}</td>
                        <td>{{ download.date_added }}</td>
                        <td><a href="{{ download.href }}" data-bs-toggle="tooltip" title="{{ button_download }}" class="pn-btn pn-btn--black"><i class="fa-solid fa-cloud-arrow-down"></i></a></td>
                      </tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
              <div class="pn-account-foot">
              <div class="pn-pagination-wrap">{{ pagination }}</div>
              <p class="pn-account-results">{{ results }}</p>
            </div>
            {% else %}
              <p>{{ text_no_results }}</p>
            {% endif %}
            <div class="pn-account-actions pn-account-actions--end">
              <a href="{{ continue }}" class="pn-btn pn-btn--black">{{ button_continue }}</a>
            </div>

      {{ content_bottom }}
    </div>

    {{ column_right }}
  </div>
</div>
{{ footer }}
