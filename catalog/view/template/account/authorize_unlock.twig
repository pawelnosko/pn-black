{{ header }}
<div id="content">
  <div class="pn-account-auth">
    <br/>
    <br/>
    <div class="row justify-content-sm-center">
      <div class="col-sm-10 col-md-8 col-lg-5">
        <div class="pn-account-card">
          <div class="pn-account-card__head"><i class="fa-solid fa-unlock"></i> {{ text_unlocked }}</div>
          <div class="pn-account-card__body">
            <p>{{ text_unlock }}</p>
            <div class="text-end">
              <a href="{{ login }}" class="pn-btn pn-btn--black"><i class="fa-solid fa-unlock"></i> {{ button_login }}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{{ footer }}
