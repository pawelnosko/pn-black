{% set lid = pn_black_language_id %}
{% set list_cfg = pn_black.category|default({}) %}
{{ header }}
{% include 'extension/pn_black/catalog/view/template/product/_listing.twig' with {
  listing_id: 'product-manufacturer-info',
  listing_eyebrow: list_cfg.eyebrow[lid]|default('Edition 01') ~ ' — ' ~ heading_title,
  listing_title_html: heading_title,
  listing_description: description|default('<p>' ~ (list_cfg.description[lid]|default('Pieces from this house — cut, material and finish.')) ~ '</p>'),
  listing_image: thumb|default('catalog/pn_black/white-dress.jpg'),
  show_subcats: false,
  show_search_form: false,
  show_hero_media: true
} %}
{{ footer }}
