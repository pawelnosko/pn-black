{#
  Theme Black
  Author: Paweł Nosko → https://pawelnosko.com/
  Company: Design Cart → https://www.designcart.pl/
#}
{% set lid = pn_black_language_id %}
{% set header_cfg = pn_black.header|default({}) %}
{% if action %}
  {# OpenCart 4.1+: POST to common/search.redirect (keeps language + SEO routing) #}
  <form action="{{ action }}" method="post" class="pn-search-form" role="search">
{% else %}
  {# Fallback for older 4.0.x: plain GET to the search route #}
  <form action="index.php" method="get" class="pn-search-form" role="search">
    <input type="hidden" name="route" value="product/search"/>
{% endif %}
  <input type="search" name="search" value="{{ search|default('') }}" placeholder="{{ header_cfg.search_placeholder[lid]|default(text_search|default('Search…'))|e('html_attr') }}" aria-label="{{ header_cfg.search_button[lid]|default('Search')|e('html_attr') }}" autocomplete="off"/>
  <button type="submit">
    <span>{{ header_cfg.search_button[lid]|default('Search')|e }}</span>
    <svg class="pn-icon" aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>
  </button>
</form>
